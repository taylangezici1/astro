# API server config. The DATABASE_URL is read by the @synastry/database client
# (Prisma) — keep it in sync with packages/database/.env, or rely on a single
# root .env loaded by NestJS ConfigModule.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synastry?schema=public"
PORT=3000
# Long random secret for signing JWTs. Generate with `openssl rand -hex 32`.
JWT_SECRET="change-me"
