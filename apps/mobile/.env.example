# Mobile app config. EXPO_PUBLIC_* vars are inlined into the JS bundle by
# Expo, so they're safe for non-secret values only.
#
#   - localhost works on Expo Web and the iOS simulator
#   - Use your machine's LAN IP (e.g. http://192.168.1.20:3010) when running
#     on a physical device through Expo Go
EXPO_PUBLIC_API_URL=http://localhost:3010
