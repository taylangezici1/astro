{
  "name": "synastry",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "db:generate": "yarn workspace @synastry/database generate",
    "db:migrate": "yarn workspace @synastry/database migrate",
    "db:deploy": "yarn workspace @synastry/database migrate:deploy",
    "db:seed": "yarn workspace @synastry/database seed",
    "mobile": "yarn workspace @synastry/mobile dev",
    "test:e2e": "yarn workspace @synastry/api test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.9.2"
  },
  "packageManager": "yarn@1.22.22"
}
